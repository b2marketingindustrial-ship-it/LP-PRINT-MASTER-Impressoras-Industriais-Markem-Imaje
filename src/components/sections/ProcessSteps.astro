---
/**
 * "Como funciona" — fase "apoio" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, pedido de 05/11/2026 (docs/BRIEFING.md): "sem conter em uma
 * caixa". O conteúdo pousa direto numa faixa verde em largura total, de cantos de cima
 * arredondados como os diferenciais (sem painel fechado nem
 * cards): texto à esquerda com CTA e selo Markem-Imaje, foto do técnico sangrando até a borda
 * direita e fundida ao verde, e as 4 etapas numa linha do tempo — ícone em círculo ligado por um
 * fio, título e frase, sem números. Continua sendo o bloco escuro da primeira metade da página.
 * H2 em três linhas no desktop e sem quebra forçada no tablet (06/11/2026).
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor, reaplique.
 */
import { Image, Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta, hero } from '@data/content'
import { process } from '@data/sections/processo'

type Props = SectionProps

const { tone, rhythm } = Astro.props

// H2 em três linhas no desktop (06/11/2026): "Codificação e" · "rastreabilidade" · destaque. Em
// duas linhas, "Codificação e rastreabilidade" passava da coluna e cobria o rosto do técnico.
const leadCut = process.titleLead.lastIndexOf(' ')
const leadA = process.titleLead.slice(0, leadCut)
const leadB = process.titleLead.slice(leadCut + 1)
---

<Section id="processo" tone={tone} rhythm={rhythm} container={false}>
  <div class="process-band relative isolate overflow-hidden rounded-t-[40px] lg:rounded-t-[64px]">
    {/* Foto à direita, sangrando até a borda e apagada para a esquerda */}
    <div
      aria-hidden="true"
      class="process-scene absolute inset-y-0 right-0 hidden w-[55%] lg:block"
    >
      <Picture
        src={process.scene.src}
        alt=""
        widths={[640, 960, 1070]}
        sizes="55vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[70%_center]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>
    <span
      aria-hidden="true"
      class="blueprint-grid pointer-events-none absolute inset-0 -z-[1]"
    ></span>

    <div class="relative mx-auto max-w-page px-6 pt-14 pb-14 lg:px-10 lg:pt-20 lg:pb-20">
      <div class="lg:max-w-[46%]">
        <Eyebrow tone="light">{process.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[2.3rem] leading-[1.04] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-5xl lg:text-[2.95rem] xl:text-[3.6rem]">
          <span class="lg:block">{leadA}</span> <span class="lg:block">{leadB}</span>{' '}
          <span class="text-brand-mint lg:block">{process.titleHighlight}</span>
        </h2>
        <span aria-hidden="true" class="mt-6 block h-[3px] w-20 rounded-full bg-brand-mint"></span>
        <p class="mt-6 max-w-[34rem] font-sans text-[17px] leading-relaxed text-neutral-light/85">
          {process.text}
        </p>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
          <Button cta="processo-cta" variant="mint" class="w-full sm:w-auto">
            {cta.primary}
          </Button>
          <span class="inline-flex shrink-0 items-center gap-3 self-start rounded-xl bg-neutral-light py-2.5 pr-4 pl-3 sm:self-auto">
            <Image
              src={hero.badge.src}
              alt={hero.badge.alt}
              width={130}
              format="webp"
              loading="lazy"
              decoding="async"
              class="h-[22px] w-auto"
            />
            <span class="border-l border-ink/15 pl-3 font-sans text-[10px] leading-tight font-bold tracking-[0.12em] whitespace-nowrap text-ink-soft uppercase">
              Distribuidor
              <br />
              autorizado
            </span>
          </span>
        </div>
      </div>

      {/* Foto no celular e no tablet, abaixo do texto */}
      <div class="process-scene-mobile relative -mx-6 mt-10 h-[300px] sm:h-[380px] lg:hidden">
        <Picture
          src={process.sceneMobile.src}
          alt={process.sceneMobile.alt}
          widths={[480, 941]}
          sizes="100vw"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-[50%_30%]"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
      </div>

      {/* Etapas numa linha do tempo, direto sobre o verde */}
      <ol
        data-timeline
        class="process-timeline relative mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6"
      >
        {process.steps.map((step, i) => (
          <li class="process-step relative flex gap-4 lg:flex-col lg:gap-0" style={`--i:${i}`}>
            <span class="process-step__icon relative z-[1] flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-mint text-primary-dark-900 shadow-[0_0_0_6px_rgb(6_67_55)]">
              <Icon name={step.icon} class="size-[22px]" />
            </span>
            <div class="lg:mt-5 lg:pr-6">
              <h3 class="font-display text-[1.1rem] leading-snug font-extrabold text-neutral-light">
                {step.title}
              </h3>
              <p class="mt-2 font-sans text-[14.5px] leading-relaxed text-neutral-light/75">
                {step.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Section>

<style>
  /* Verde profundo com luz no alto à esquerda, em largura total. */
  .process-band {
    background:
      radial-gradient(60% 80% at 0% 0%, rgb(26 165 122 / 0.3) 0%, transparent 60%),
      linear-gradient(
        160deg,
        var(--color-primary-dark-800) 0%,
        var(--color-primary-dark) 45%,
        var(--color-hero-deep) 100%
      );
  }

  /* A foto se apaga para a esquerda e na base, sob a linha do tempo. */
  .process-scene {
    mask-image:
      linear-gradient(to right, transparent 0%, black 40%),
      linear-gradient(to top, transparent 0%, black 45%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .process-scene-mobile {
    mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 75%, transparent 100%);
  }

  /* Fio da linha do tempo, passando pelo centro dos ícones (desktop). */
  @media (min-width: 1024px) {
    .process-timeline::before {
      content: '';
      position: absolute;
      top: 24px;
      left: 24px;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, rgb(97 229 169 / 0.6), rgb(97 229 169 / 0.15));
      transform-origin: left;
    }

    /* Ao entrar na tela, o fio se desenha da esquerda para a direita. */
    [data-timeline].is-armed::before {
      transform: scaleX(0);
    }

    [data-timeline].is-in::before {
      transform: scaleX(1);
      transition: transform 1400ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  /* Etapas entram em sequência, subindo e acendendo; o ícone pulsa um anel menta. */
  [data-timeline].is-armed .process-step {
    opacity: 0;
    transform: translateY(14px);
  }

  [data-timeline].is-in .process-step {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms ease-out,
      transform 600ms ease-out;
    transition-delay: calc(var(--i) * 220ms + 200ms);
  }

  [data-timeline].is-in .process-step__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    box-shadow: 0 0 0 0 rgb(97 229 169 / 0.55);
    /* Três pulsos e para: animação infinita pesava no celular (06/11/2026). */
    animation: process-ping 2.8s ease-out 3;
    animation-delay: calc(var(--i) * 0.7s + 1.2s);
  }

  @keyframes process-ping {
    0% {
      box-shadow: 0 0 0 0 rgb(97 229 169 / 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 14px rgb(97 229 169 / 0);
    }
  }

  .process-step:hover .process-step__icon {
    transform: scale(1.08);
  }

  .process-step__icon {
    transition: transform 300ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-timeline].is-armed .process-step,
    [data-timeline].is-armed::before {
      opacity: 1;
      transform: none;
    }

    .process-step__icon::after {
      animation: none !important;
    }
  }
</style>

<script>
  // Só arma a animação com JS ativo: sem ele (ou sem IntersectionObserver), tudo já aparece.
  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((el) => {
    if (!('IntersectionObserver' in window)) return
    el.classList.add('is-armed')
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          el.classList.add('is-in')
          io.disconnect()
        }
      },
      { threshold: 0.3 },
    )
    io.observe(el)
  })
</script>
