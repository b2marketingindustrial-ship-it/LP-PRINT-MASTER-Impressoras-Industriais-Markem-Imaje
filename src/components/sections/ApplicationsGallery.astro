---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 27/10/2026 (docs/BRIEFING.md): cabeçalho centrado
 * com o H2 numa linha só (05/11/2026), cards com foto 6:5 em cima e corpo verde-escuro (título, frase e
 * seta), sem faixa de ajuda no fim (removida em 05/11/2026). O card inteiro é o CTA.
 * Pedido do usuário (05/11/2026): as 11 aplicações rodam numa esteira infinita com setas nas
 * laterais; com movimento reduzido vira um trilho com rolagem. Desde 06/11/2026 (WCAG 2.2.2): botão
 * de pausar/continuar abaixo da esteira, pausa ao tocar no celular (volta 4 s depois), e o card
 * focado pelo teclado é trazido para dentro da tela, sem a máscara das bordas por cima.
 * Item sem foto mostra o ícone num palco verde.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor, reaplique a variante.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <div class="mx-auto max-w-5xl text-center">
    <Eyebrow>{applications.eyebrow}</Eyebrow>
    <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance text-primary-dark sm:text-5xl lg:text-[3.35rem] xl:whitespace-nowrap">
      {applications.title}
    </h2>
    <p class="mt-4 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px] lg:text-lg">
      {applications.text}
    </p>
  </div>

  {/* Esteira infinita: a lista roda duas vezes; a cópia fica fora da leitura e do teclado. */}
  <div class="relative mt-10 -mb-12" data-marquee>
    <div class="app-marquee relative ml-[calc(50%-50vw)] w-screen">
      <div class="app-track flex w-max">
        {[0, 1].map((copy) => (
          <ul
            class="flex shrink-0 gap-5 pt-3 pb-14 pr-5 lg:gap-6 lg:pr-6"
            aria-label={copy === 0 ? applications.eyebrow : undefined}
            aria-hidden={copy === 1 ? 'true' : undefined}
            inert={copy === 1}
            data-copy={copy}
          >
            {applications.items.map((app) => (
              <li class="w-[272px] shrink-0 sm:w-[300px] lg:w-[318px]">
                <button
                  type="button"
                  data-cta={`aplicacoes-${app.id}`}
                  class="btn-slave-whats app-card group flex h-full w-full flex-col overflow-hidden rounded-[20px] bg-primary-dark text-left shadow-[0_26px_50px_-30px_rgba(6,67,55,0.6)] ring-1 ring-primary-dark/10 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(1,36,34,0.75)]"
                >
                  {app.photo ? (
                    <span class="block aspect-[6/5] overflow-hidden bg-primary-dark-900">
                      <Image
                        src={app.photo.src}
                        alt={app.photo.alt}
                        format="webp"
                        widths={[400]}
                        sizes="320px"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
                      />
                    </span>
                  ) : (
                    <span class="app-card__stage relative flex aspect-[6/5] items-center justify-center overflow-hidden">
                      <span aria-hidden="true" class="app-card__grid absolute inset-0"></span>
                      <span
                        aria-hidden="true"
                        class="absolute size-40 rounded-full border border-brand-glow/15"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="absolute size-56 rounded-full border border-dashed border-brand-glow/10"
                      ></span>
                      <span class="relative flex size-[4.5rem] items-center justify-center rounded-2xl bg-white/8 text-brand-glow ring-1 ring-brand-glow/30 backdrop-blur-sm transition-transform duration-500 ease-out group-hover:scale-110">
                        <Icon name={app.icon} class="size-9" />
                      </span>
                    </span>
                  )}
                  <span class="app-card__body flex flex-1 flex-col px-6 pt-5 pb-6">
                    <span class="font-display text-[1.3rem] leading-snug font-extrabold text-neutral-light">
                      {app.label}
                    </span>
                    <span class="mt-2 flex flex-1 items-center justify-between gap-3">
                      <span class="font-sans text-[14.5px] leading-relaxed text-neutral-light/85">
                        {app.description}
                      </span>
                      <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-primary-dark transition-[background-color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-mint">
                        <Icon name="arrow-right" class="size-5" />
                      </span>
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    {/* Navegação nas laterais: cada seta avança ou volta um card (05/11/2026) */}
    {[
      {
        dir: -1,
        label: 'Aplicação anterior',
        side: '-left-2 sm:left-0',
        rot: 'rotate-180',
      },
      { dir: 1, label: 'Próxima aplicação', side: '-right-2 sm:right-0', rot: '' },
    ].map((b) => (
      <button
        type="button"
        data-marquee-step={b.dir}
        aria-label={b.label}
        class:list={[
          'app-nav absolute top-[calc(50%-1.25rem)] z-10 hidden size-12 -translate-y-1/2 items-center justify-center rounded-full bg-neutral-light text-primary-dark shadow-[0_14px_30px_-12px_rgba(1,36,34,0.55)] ring-1 ring-primary-dark/10 transition-[background-color,color,transform] duration-200 hover:scale-105 hover:bg-accent-orange hover:text-neutral-light',
          b.side,
        ]}
      >
        <Icon name="chevron-right" class:list={['size-5', b.rot]} />
      </button>
    ))}

    {/* Pausar/continuar (06/11/2026): `aria-pressed` diz se a esteira está pausada pelo visitante */}
    <button
      type="button"
      data-marquee-toggle
      aria-pressed="false"
      aria-label="Pausar a esteira de aplicações"
      class="app-nav app-toggle absolute bottom-2 left-1/2 z-10 hidden size-10 -translate-x-1/2 items-center justify-center rounded-full bg-neutral-light text-primary-dark shadow-[0_10px_24px_-12px_rgba(1,36,34,0.5)] ring-1 ring-primary-dark/10 transition-colors duration-200 hover:bg-accent-orange hover:text-neutral-light"
    >
      <Icon name="pause" class="app-toggle__pause size-4" />
      <Icon name="play" class="app-toggle__play size-4" />
    </button>
  </div>
</Section>

<style>
  /* Corpo verde do card, como os segmentos da LP de locação. */
  .app-card__body {
    background-image: linear-gradient(
      170deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark) 100%
    );
  }

  /* Palco de quem ainda não tem foto: verde profundo, malha fina e luz menta no centro. */
  .app-card__stage {
    background:
      radial-gradient(60% 80% at 50% 50%, rgb(26 165 122 / 0.35) 0%, transparent 70%),
      linear-gradient(160deg, var(--color-primary-dark-800) 0%, var(--color-hero-deep) 100%);
  }

  .app-card__grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 75%);
  }

  /* Esteira: a trilha tem a lista duas vezes e anda metade da própria largura. */
  .app-marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .app-track {
    animation: app-marquee 75s linear infinite;
  }

  .app-marquee:hover .app-track,
  .app-marquee:focus-within .app-track {
    animation-play-state: paused;
  }

  /* Card em foco pelo teclado: sem o esmaecido das bordas por cima dele. */
  .app-marquee:focus-within {
    mask-image: none;
  }

  /* Ícone do botão de pausa conforme o estado. */
  .app-toggle[aria-pressed='true'] :global(.app-toggle__pause),
  .app-toggle[aria-pressed='false'] :global(.app-toggle__play) {
    display: none;
  }

  /* Com JS a esteira é movida pelo script (para as setas poderem empurrar); sem JS, a animação
     CSS acima continua valendo e as setas ficam escondidas. */
  [data-marquee].is-js .app-track {
    animation: none;
    will-change: transform;
  }

  [data-marquee].is-js .app-nav {
    display: flex;
  }

  @keyframes app-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-marquee {
      overflow-x: auto;
      mask-image: none;
      scroll-snap-type: x mandatory;
    }

    .app-track {
      animation: none;
    }

    .app-nav {
      display: none !important;
    }

    .app-track [data-copy='1'] {
      display: none;
    }

    .app-track li {
      scroll-snap-align: start;
    }

    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>

<script>
  // Esteira infinita movida por JS: anda sozinha e para no hover, no foco, ao tocar e no botão de
  // pausa; as setas empurram um card por vez. A trilha tem a lista duas vezes e o deslocamento dá
  // a volta na metade da largura, sem emenda. Só anima quando está na tela e andando, e as medidas
  // ficam guardadas (ler scrollWidth a cada quadro forçava o recálculo do layout no celular).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const belt = root.querySelector<HTMLElement>('.app-marquee')
    const track = root.querySelector<HTMLElement>('.app-track')
    const toggle = root.querySelector<HTMLButtonElement>('[data-marquee-toggle]')
    if (!belt || !track || reduce) return
    root.classList.add('is-js')

    const SPEED = 40 // px por segundo
    const TOUCH_RESUME = 4000 // ms depois do toque
    let offset = 0
    let hover = false
    let focus = false
    let touch = false
    let userPaused = false
    let visible = true
    let touchTimer = 0
    let jump: { from: number; to: number; start: number } | null = null
    let last = performance.now()
    let raf = 0

    let half = 0
    let step = 0
    const measure = () => {
      half = track.scrollWidth / 2
      const li = track.querySelector<HTMLElement>('li')
      const gap = parseFloat(getComputedStyle(li?.parentElement ?? track).columnGap) || 20
      step = (li?.offsetWidth ?? 300) + gap
    }
    measure()
    new ResizeObserver(measure).observe(track)

    const wrap = (x: number) => (half ? ((x % half) + half) % half : 0)
    const moving = () => !(hover || focus || touch || userPaused)

    const frame = (now: number) => {
      raf = 0
      const dt = Math.min(now - last, 64) / 1000
      last = now
      if (jump) {
        const t = Math.min((now - jump.start) / 520, 1)
        const ease = 1 - Math.pow(1 - t, 3)
        offset = jump.from + (jump.to - jump.from) * ease
        if (t === 1) jump = null
      } else if (moving()) {
        offset += SPEED * dt
      }
      track.style.transform = `translate3d(${-wrap(offset)}px,0,0)`
      if (visible && (jump || moving())) raf = requestAnimationFrame(frame)
    }
    const run = () => {
      if (raf || !visible) return
      last = performance.now()
      raf = requestAnimationFrame(frame)
    }
    run()

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting
      if (visible) run()
    }).observe(belt)

    // Só mouse de verdade: no celular o toque também gera "mouseenter" e a esteira ficaria parada.
    belt.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') hover = true
    })
    belt.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return
      hover = false
      run()
    })

    // Toque no celular: para enquanto o dedo está na esteira e volta alguns segundos depois.
    belt.addEventListener(
      'touchstart',
      () => {
        touch = true
        clearTimeout(touchTimer)
      },
      { passive: true },
    )
    belt.addEventListener('touchend', () => {
      clearTimeout(touchTimer)
      touchTimer = window.setTimeout(() => {
        touch = false
        run()
      }, TOUCH_RESUME)
    })

    // O navegador rola a esteira por dentro para mostrar o card focado; essa rolagem é desfeita e
    // o card é trazido para a tela pelo próprio deslocamento da esteira.
    belt.addEventListener('scroll', () => {
      if (belt.scrollLeft) belt.scrollLeft = 0
    })
    belt.addEventListener('focusin', (event) => {
      focus = true
      belt.scrollLeft = 0
      const li = (event.target as HTMLElement).closest('li')
      if (!li) return
      const at = li.getBoundingClientRect().left - belt.getBoundingClientRect().left + wrap(offset)
      const target = Math.min(Math.max(0, at - (belt.clientWidth - li.offsetWidth) / 2), half - 1)
      offset = wrap(offset)
      jump = { from: offset, to: target, start: performance.now() }
      run()
    })
    belt.addEventListener('focusout', (event) => {
      if (belt.contains(event.relatedTarget as Node | null)) return
      focus = false
      run()
    })

    root.querySelectorAll<HTMLButtonElement>('[data-marquee-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.marqueeStep)
        const from = jump ? jump.to : offset
        jump = { from: offset, to: from + dir * step, start: performance.now() }
        run()
      })
    })

    toggle?.addEventListener('click', () => {
      userPaused = !userPaused
      toggle.setAttribute('aria-pressed', String(userPaused))
      run()
    })
  })
</script>
