---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 27/10/2026 (docs/BRIEFING.md): cabeçalho centrado
 * com o H2 em duas linhas, 4 cards com foto 8:5 em cima e corpo verde-escuro (título, frase e
 * seta), e uma faixa "Encontre a solução ideal…" com CTA no fim. O card inteiro é o CTA.
 * Pedido do usuário (05/11/2026): as 11 aplicações rodam numa esteira infinita, que para no
 * hover, no foco e no botão de pausa; com movimento reduzido vira um trilho com rolagem.
 * Item sem foto mostra o ícone num palco verde.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor, reaplique a variante.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <div class="mx-auto max-w-4xl text-center">
    <span class="inline-flex items-center gap-3.5 font-sans text-[12px] font-semibold tracking-[0.3em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-1 w-10 rounded-full bg-accent-orange"></span>
      {applications.eyebrow}
    </span>
    <h2 class="mt-4 font-display text-[2.1rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-5xl lg:text-[3.6rem]">
      {/* Duas linhas fixas a partir do tablet; no celular o título quebra sozinho. */}
      {applications.titleLines.map((line) => (
        <span class="sm:block">{line} </span>
      ))}
    </h2>
    <p class="mt-4 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px] lg:text-lg">
      {applications.text}
    </p>
  </div>

  {/* Esteira infinita: a lista roda duas vezes; a cópia fica fora da leitura e do teclado. */}
  <div class="mt-10" data-marquee>
    <div class="app-marquee ml-[calc(50%-50vw)] w-screen">
      <div class="app-track flex w-max">
        {[0, 1].map((copy) => (
          <ul
            class="flex shrink-0 gap-5 py-3 pr-5 lg:gap-6 lg:pr-6"
            aria-label={copy === 0 ? applications.eyebrow : undefined}
            aria-hidden={copy === 1 ? 'true' : undefined}
            inert={copy === 1}
            data-copy={copy}
          >
            {applications.items.map((app) => (
              <li class="w-[272px] shrink-0 sm:w-[300px] lg:w-[318px]">
                <button
                  type="button"
                  data-cta={`aplicacoes-${app.id}`}
                  class="btn-slave-whats app-card group flex h-full w-full flex-col overflow-hidden rounded-2xl bg-primary-dark text-left shadow-[0_22px_44px_-28px_rgba(1,36,34,0.65)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(1,36,34,0.75)]"
                >
                  {app.photo ? (
                    <span class="block aspect-[8/5] overflow-hidden bg-primary-dark-900">
                      <Image
                        src={app.photo.src}
                        alt={app.photo.alt}
                        format="webp"
                        widths={[400]}
                        sizes="320px"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
                      />
                    </span>
                  ) : (
                    <span class="app-card__stage relative flex aspect-[8/5] items-center justify-center overflow-hidden">
                      <span aria-hidden="true" class="app-card__grid absolute inset-0"></span>
                      <span
                        aria-hidden="true"
                        class="absolute size-40 rounded-full border border-brand-glow/15"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="absolute size-56 rounded-full border border-dashed border-brand-glow/10"
                      ></span>
                      <span class="relative flex size-[4.5rem] items-center justify-center rounded-2xl bg-white/8 text-brand-glow ring-1 ring-brand-glow/30 backdrop-blur-sm transition-transform duration-500 ease-out group-hover:scale-110">
                        <Icon name={app.icon} class="size-9" />
                      </span>
                    </span>
                  )}
                  <span class="app-card__body flex flex-1 flex-col px-6 pt-5 pb-6">
                    <span class="font-display text-[1.2rem] leading-snug font-bold text-neutral-light lg:text-[1.3rem]">
                      {app.label}
                    </span>
                    <span class="mt-2 font-sans text-[14px] leading-relaxed text-neutral-light/80">
                      {app.description}
                    </span>
                    <span aria-hidden="true" class="min-h-4 flex-1"></span>
                    <span class="flex items-center justify-between gap-3 border-t border-white/15 pt-4">
                      <span class="font-sans text-[13.5px] font-medium text-neutral-light/90">
                        {cta.card}
                      </span>
                      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light transition-transform duration-300 group-hover:translate-x-0.5">
                        <Icon name="arrow-right" class="size-[18px]" />
                      </span>
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <div class="mt-4 flex justify-end">
      <button
        type="button"
        data-marquee-toggle
        aria-pressed="false"
        aria-label="Pausar o carrossel de aplicações"
        class="app-marquee__toggle flex size-9 items-center justify-center rounded-full border border-ink/15 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange lg:right-10"
      >
        <svg
          data-icon-pause
          class="size-3.5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <rect x="6" y="4.5" width="4" height="15" rx="1" />
          <rect x="14" y="4.5" width="4" height="15" rx="1" />
        </svg>
        <svg
          data-icon-play
          class="hidden size-3.5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M7 4.8v14.4c0 .8.9 1.3 1.6.8l11-7.2a1 1 0 0 0 0-1.6l-11-7.2C7.9 3.5 7 4 7 4.8Z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mt-8 flex flex-col gap-3 border-t border-ink/10 pt-7 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p class="font-sans text-[16px] text-ink-soft sm:text-[17px]">{applications.help.text}</p>
    <button
      type="button"
      data-cta="aplicacoes-cta"
      class="btn-slave-whats group inline-flex shrink-0 items-center gap-3 self-start font-sans text-[16px] font-bold text-primary-dark transition-colors duration-200 hover:text-accent-orange sm:self-auto sm:text-[17px]"
    >
      {applications.help.cta}
      <Icon
        name="arrow-right"
        class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    </button>
  </div>
</Section>

<style>
  /* Corpo verde-escuro do card, com um brilho sutil no topo. */
  .app-card__body {
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.06) 0%, transparent 60%),
      linear-gradient(165deg, var(--color-primary-dark) 0%, var(--color-primary-dark-900) 100%);
  }

  /* Palco de quem ainda não tem foto: verde profundo, malha fina e luz menta no centro. */
  .app-card__stage {
    background:
      radial-gradient(60% 80% at 50% 50%, rgb(26 165 122 / 0.35) 0%, transparent 70%),
      linear-gradient(160deg, var(--color-primary-dark-800) 0%, var(--color-hero-deep) 100%);
  }

  .app-card__grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 75%);
  }

  /* Esteira: a trilha tem a lista duas vezes e anda metade da própria largura. */
  .app-marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .app-track {
    animation: app-marquee 75s linear infinite;
  }

  .app-marquee:hover .app-track,
  .app-marquee:focus-within .app-track,
  [data-marquee][data-paused] .app-track {
    animation-play-state: paused;
  }

  @keyframes app-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-marquee {
      overflow-x: auto;
      mask-image: none;
      scroll-snap-type: x mandatory;
    }

    .app-track {
      animation: none;
    }

    .app-track [data-copy='1'],
    .app-marquee__toggle {
      display: none;
    }

    .app-track li {
      scroll-snap-align: start;
    }

    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-marquee-toggle]')
    if (!toggle) return
    toggle.addEventListener('click', () => {
      const paused = root.toggleAttribute('data-paused')
      toggle.setAttribute('aria-pressed', String(paused))
      toggle.setAttribute(
        'aria-label',
        paused ? 'Retomar o carrossel de aplicações' : 'Pausar o carrossel de aplicações',
      )
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused)
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused)
    })
  })
</script>
