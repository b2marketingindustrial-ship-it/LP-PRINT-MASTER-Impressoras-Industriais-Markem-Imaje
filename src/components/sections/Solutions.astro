---
/**
 * Soluções — fase "oferta", entre o hero e a vitrine.
 *
 * VARIANTE LOCAL — Print Master, pedido de 05/11/2026 (docs/BRIEFING.md): seção nova, sem par
 * na biblioteca. Duas colunas no desktop: à esquerda eyebrow, H2 com trecho em verde, texto do
 * cliente, setores em chips e o par de logos Print Master + Markem-Imaje; à direita as 4
 * soluções em cards 2×2, com ícone em caixa verde. No celular tudo empilha.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { solutions } from '@data/sections/solucoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = solutions.title.indexOf(solutions.highlight)
if (at < 0) throw new Error('solucoes: highlight precisa estar dentro de title.')
const titleBefore = solutions.title.slice(0, at)
const titleAfter = solutions.title.slice(at + solutions.highlight.length)
---

<Section id="solucoes" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16">
    {/* Coluna 1 — mensagem */}
    <div class="lg:col-span-5">
      <span class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.22em] text-ink-soft uppercase">
        <span aria-hidden="true" class="h-[3px] w-6 rounded-full bg-accent-orange"></span>
        {solutions.eyebrow}
      </span>
      <h2 class="mt-3 font-display text-3xl leading-[1.08] font-extrabold tracking-[-0.025em] text-ink sm:text-4xl lg:text-[2.6rem]">
        {titleBefore}
        <span class="text-accent-orange">{solutions.highlight}</span>
        {titleAfter}
      </h2>
      <p class="mt-5 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[16.5px]">
        {solutions.text}
      </p>

      <p class="mt-7 font-sans text-[11.5px] font-bold tracking-[0.18em] text-ink-soft/80 uppercase">
        {solutions.sectorsLabel}
      </p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label={solutions.sectorsLabel}>
        {solutions.sectors.map((sector) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-brand-mint-soft px-3.5 py-1.5 font-sans text-[13.5px] font-semibold text-primary-dark ring-1 ring-brand-leaf/20">
            <Icon name="check" class="size-3.5 text-accent-orange" />
            {sector}
          </li>
        ))}
      </ul>

      <div class="mt-8 flex items-stretch gap-3 sm:gap-4">
        {solutions.logos.map((logo) => (
          <span class="flex h-[76px] flex-1 items-center justify-center rounded-2xl bg-neutral-light px-5 shadow-[0_16px_34px_-26px_rgba(6,67,55,0.55)] ring-1 ring-primary-dark/10 sm:h-[84px] sm:max-w-[13.5rem]">
            <Image
              src={logo.src}
              alt={logo.alt}
              width={180}
              format="webp"
              loading="lazy"
              decoding="async"
              class="h-auto max-h-9 w-auto max-w-full"
            />
          </span>
        ))}
      </div>
    </div>

    {/* Coluna 2 — soluções em destaque */}
    <div class="lg:col-span-7">
      <h3 class="flex items-center gap-3 font-display text-lg font-bold text-primary-dark sm:text-xl">
        {solutions.listTitle}
        <span
          aria-hidden="true"
          class="h-px flex-1 bg-gradient-to-r from-brand-leaf/40 to-transparent"
        ></span>
      </h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 sm:gap-5">
        {solutions.items.map((item, i) => (
          <li class="solution-card group relative flex flex-col overflow-hidden rounded-[20px] bg-neutral-light p-6 shadow-[0_1px_2px_rgba(6,67,55,0.06),0_22px_46px_-32px_rgba(6,67,55,0.55)] ring-1 ring-primary-dark/10 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_1px_2px_rgba(6,67,55,0.06),0_30px_56px_-30px_rgba(6,67,55,0.6)] hover:ring-brand-leaf/40 lg:p-7">
            <span
              aria-hidden="true"
              class="solution-card__glow pointer-events-none absolute -top-16 -right-16 size-44 rounded-full opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            ></span>
            <div class="relative flex items-start justify-between">
              <span class="solution-card__icon flex size-12 items-center justify-center rounded-xl text-brand-glow">
                <Icon name={item.icon} class="size-[22px]" />
              </span>
              <span
                aria-hidden="true"
                data-index={String(i + 1).padStart(2, '0')}
                class="solution-card__num font-display text-[12px] font-extrabold tracking-[0.2em] text-primary-dark/25"
              ></span>
            </div>
            <h4 class="relative mt-5 font-display text-[1.1rem] leading-snug font-bold text-ink">
              {item.title}
            </h4>
            <p class="relative mt-2 font-sans text-[14px] leading-relaxed text-ink-soft">
              {item.description}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .solution-card__icon {
    background: linear-gradient(
      145deg,
      var(--color-primary-dark-800) 0%,
      var(--color-primary-dark) 55%,
      var(--color-primary-dark-900) 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 10px 20px -12px rgb(1 36 34 / 0.8);
  }

  .solution-card__glow {
    background: radial-gradient(circle, rgb(124 239 192 / 0.28) 0%, transparent 70%);
  }

  /* Índice por CSS: decorativo, fora da leitura. */
  .solution-card__num::before {
    content: attr(data-index);
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-card {
      transition: none;
    }

    .solution-card:hover {
      transform: none;
    }
  }
</style>
