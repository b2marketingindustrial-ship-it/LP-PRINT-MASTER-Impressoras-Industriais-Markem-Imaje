---
/**
 * Soluções — fase "oferta", entre o hero e a vitrine.
 *
 * VARIANTE LOCAL — Print Master, pedido de 05/11/2026 (docs/BRIEFING.md): seção nova, sem par
 * na biblioteca. Duas colunas no desktop: à esquerda eyebrow, H2 com trecho em verde, texto do
 * cliente e o CTA padrão de contato (`solucoes-cta`); à direita as 4
 * soluções em cards 2×2, com ícone em caixa verde. As duas colunas têm a mesma altura no desktop
 * (05/11/2026): o CTA desce até a base dos cards e as linhas de cards dividem a altura por igual.
 * No celular tudo empilha.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { solutions } from '@data/sections/solucoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const at = solutions.title.indexOf(solutions.highlight)
if (at < 0) throw new Error('solucoes: highlight precisa estar dentro de title.')
const titleBefore = solutions.title.slice(0, at)
const titleAfter = solutions.title.slice(at + solutions.highlight.length)
---

<Section id="solucoes" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16">
    {/* Coluna 1 — mensagem */}
    <div class="lg:col-span-5 lg:flex lg:flex-col">
      <Eyebrow>{solutions.eyebrow}</Eyebrow>
      <h2 class="mt-4 font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-ink sm:text-5xl lg:text-[2.75rem]">
        {titleBefore}
        <span class="text-accent-orange">{solutions.highlight}</span>
        {titleAfter}
      </h2>
      <p class="mt-5 font-sans text-[17px] leading-relaxed text-ink-soft">{solutions.text}</p>

      {/* No desktop o botão desce até a base dos cards: as duas colunas fecham na mesma linha. */}
      <span aria-hidden="true" class="hidden lg:block lg:min-h-8 lg:flex-1"></span>
      <Button cta="solucoes-cta" class="mt-8 w-full sm:w-auto lg:mt-0 lg:self-start">
        {cta.primary}
      </Button>
    </div>

    {/* Coluna 2 — soluções em destaque */}
    <div class="lg:col-span-7 lg:flex lg:flex-col">
      <h3 class="flex items-center gap-3 font-display text-lg font-bold text-primary-dark sm:text-xl">
        {solutions.listTitle}
        <span
          aria-hidden="true"
          class="h-px flex-1 bg-gradient-to-r from-brand-leaf/40 to-transparent"
        ></span>
      </h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:flex-1 lg:auto-rows-fr">
        {solutions.items.map((item) => (
          <li class="solution-card group relative flex flex-col overflow-hidden rounded-[20px] bg-neutral-light p-6 shadow-[0_1px_2px_rgba(6,67,55,0.06),0_22px_46px_-32px_rgba(6,67,55,0.55)] ring-1 ring-primary-dark/10 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_1px_2px_rgba(6,67,55,0.06),0_30px_56px_-30px_rgba(6,67,55,0.6)] hover:ring-brand-leaf/40 lg:p-7">
            <span
              aria-hidden="true"
              class="solution-card__glow pointer-events-none absolute -top-16 -right-16 size-44 rounded-full opacity-70 transition-opacity duration-300 group-hover:opacity-100"
            ></span>
            <div class="relative flex items-start justify-between">
              <span class="flex size-12 items-center justify-center rounded-full bg-brand-mint-soft text-accent-orange ring-1 ring-brand-mint/60">
                <Icon name={item.icon} class="size-[22px]" />
              </span>
            </div>
            <h4 class="relative mt-5 font-display text-[1.1rem] leading-snug font-bold text-ink">
              {item.title}
            </h4>
            <p class="relative mt-2 font-sans text-[14px] leading-relaxed text-ink-soft">
              {item.description}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .solution-card__glow {
    background: radial-gradient(circle, rgb(124 239 192 / 0.28) 0%, transparent 70%);
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-card {
      transition: none;
    }

    .solution-card:hover {
      transform: none;
    }
  }
</style>
