---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * Bloco navy em largura total (por isso `container={false}`) com 5 cards
 * sobrepostos à sua base. É a segunda seção que carrega bloco navy: o respiro
 * escuro da segunda metade, imediatamente antes da conversão.
 *
 * VARIANTE LOCAL — Print Master, mockup de 27/10/2026 (docs/BRIEFING.md): a cena (fundo escuro
 * à esquerda, equipamentos e linha de envase à direita) cobre o bloco inteiro e substitui a
 * pessoa recortada. Pedido de 05/11/2026: desenho e foco institucional da LP de locação (cantos
 * de cima arredondados, H2 branco, traço menta, cards compactos). Antes (referência SEIVE): eyebrow com traço, última linha do
 * H2 em menta, CTA padrão com WhatsApp e cards compactos com ícone e título na mesma linha. `npm run compose` sobrescreve este arquivo: reaplique ao recompor.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Eyebrow from '@components/Eyebrow.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false} class="relative">
  {/* Bloco escuro em largura total, com a cena por trás */}
  <div class="why-hero relative overflow-hidden rounded-t-[40px] bg-hero-deep lg:rounded-t-[64px]">
    <div class="why-scene">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1024, 1600, 1935]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="why-scene-img"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    <div class="relative z-[2] mx-auto w-full max-w-page px-6 pt-12 pb-10 lg:px-10 lg:pt-24 lg:pb-32">
      <div class="max-w-xl lg:max-w-[680px]">
        <Eyebrow tone="light">{why.eyebrow}</Eyebrow>
        <h2 class="mt-4 font-display text-[2.3rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-5xl lg:text-[3.1rem] xl:text-[3.4rem]">
          {why.titleLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h2>

        <span aria-hidden="true" class="mt-6 block h-[3px] w-20 rounded-full bg-brand-mint"></span>

        <p class="mt-6 max-w-[36rem] font-sans text-base leading-relaxed text-neutral-light/85 sm:text-lg">
          {why.text}
        </p>

        <Button cta="diferenciais-cta" variant="mint" class="mt-8 w-full sm:w-auto">
          {cta.primary}
        </Button>
      </div>
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco escuro */}
  <div class="relative z-10 mx-auto -mt-16 max-w-page px-6 lg:-mt-20 lg:px-10" data-why>
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label={why.eyebrow}
      tabindex="0"
    >
      {why.reasons.map((reason) => (
        <li class="why-card group relative flex w-[78%] shrink-0 snap-start flex-col gap-2.5 overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-4 shadow-[0_24px_48px_-24px_rgba(1,36,34,0.45)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_32px_60px_-28px_rgba(1,36,34,0.5)] sm:w-[44%] lg:w-auto">
          <div class="flex items-center gap-3">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-neutral-gray-100 text-primary-dark-800 transition-colors duration-300 group-hover:bg-accent-orange/10 group-hover:text-accent-orange">
              <Icon name={reason.icon} class="size-[18px]" />
            </span>
            <h3 class="font-display text-[15px] leading-snug font-bold text-ink">{reason.title}</h3>
          </div>
          <p class="font-sans text-[13.5px] leading-relaxed text-ink-soft">{reason.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  .why-hero {
    isolation: isolate;
  }

  /* Mobile: a cena vem abaixo do texto, recortada nos equipamentos e fundida ao bloco. */
  .why-scene {
    position: relative;
    order: 2;
    height: 340px;
    mask-image: linear-gradient(to bottom, transparent 0, black 30%);
  }

  .why-scene :global(.why-scene-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% center;
  }

  .why-hero {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    /* Desktop: a cena cobre o bloco inteiro, presa ao alto e à direita, como no mockup. */
    .why-hero {
      display: block;
      min-height: 600px;
    }

    .why-scene {
      position: absolute;
      inset: 0;
      z-index: 1;
      height: auto;
      mask-image: none;
    }

    .why-scene :global(.why-scene-img) {
      object-position: right top;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card * {
      transition: none !important;
    }

    .why-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
