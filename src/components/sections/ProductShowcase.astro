---
/**
 * Vitrine de produtos — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 26/10/2026 (docs/BRIEFING.md): cada card tem a foto
 * grande em cima e um painel verde-escuro com a marca, o modelo em destaque e "Ver equipamento";
 * uma faixa de ajuda fecha a seção. Pedido de 05/11/2026: sem abas nem filtro — os 12 modelos
 * ficam à vista, numa faixa por tecnologia aberta por um bloco com ícone, nome, frase e contagem;
 * fim do H2 em verde, palco da foto com luz e sombra de piso, e a ajuda num cartão com botão.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor,
 * reaplique a variante.
 *
 * Sem grupos, a vitrine continua uma grade só.
 *
 * As duas invariantes do conteúdo são verificadas aqui, no build, porque o
 * `contract` do manifesto não expressa condição entre itens: descrição é tudo ou
 * nada, e todo item de vitrine agrupada aponta para um grupo existente.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import ContactStrip from '@components/ContactStrip.astro'
import type { SectionProps } from '@lib/layout'
import { showcase, type ShowcaseGroup, type ShowcaseItem } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Tipos largos de propósito: o `as const` dos dados deixa `groups: []` como `readonly []`
// e os ids como literais, e as verificações abaixo virariam `never` na vitrine sem grupos.
const { groups, items }: { groups: readonly ShowcaseGroup[]; items: readonly ShowcaseItem[] } =
  showcase

const described = items.filter((item) => item.description.trim()).length
if (described !== 0 && described !== items.length) {
  throw new Error(
    `vitrine: descrição é tudo ou nada — ${described} de ${items.length} itens têm a frase. ` +
      'Complete os que faltam ou apague todas: meia lista descrita lê como página inacabada.',
  )
}
const showText = described === items.length

const groupIds = new Set(groups.map((group) => group.id))
for (const item of items) {
  // Com grupos, item sem grupo não cai em faixa nenhuma e sumiria da página em silêncio.
  if ((groups.length || item.group) && !groupIds.has(item.group)) {
    throw new Error(
      item.group
        ? `vitrine: o item "${item.id}" aponta para o grupo "${item.group}", que não existe em groups.`
        : `vitrine: o item "${item.id}" está sem grupo — com groups preenchido, todo item aponta para um deles.`,
    )
  }
}

/** Com grupos, uma faixa por tecnologia, todas à vista; sem grupos, uma grade só. */
const grouped = groups.length > 0
const shelves = grouped
  ? groups.map((group) => ({
      id: group.id,
      label: group.label,
      icon: group.icon,
      description: group.description,
      items: items.filter((item) => item.group === group.id),
    }))
  : [{ id: 'todos', label: showcase.title, icon: null, description: '', items: [...items] }]

/**
 * No desktop cada faixa fecha 6 colunas (3 no lg): o bloco da tecnologia ocupa o que os
 * modelos deixam livre — 5 + 1, 4 + 2, 3 + 3 —, e todos os cards ficam do mesmo tamanho.
 */
const headSpan: Record<number, string> = {
  5: 'lg:col-span-1',
  4: 'lg:col-span-2',
  3: 'lg:col-span-3',
}

for (const shelf of shelves) {
  if (!shelf.items.length) {
    throw new Error(
      `vitrine: o grupo "${shelf.id}" está sem itens. Remova o grupo ou aponte itens para ele.`,
    )
  }
}

const titleLead = showcase.title.endsWith(showcase.titleHighlight)
  ? showcase.title.slice(0, -showcase.titleHighlight.length).trim()
  : showcase.title
if (titleLead === showcase.title) {
  throw new Error('vitrine: titleHighlight precisa ser o final exato de title.')
}

const countLabel = (n: number) => `${n} ${n === 1 ? 'modelo' : 'modelos'}`

/** O card mostra a marca em cima e o modelo em destaque: "Markem-Imaje 9018" → "9018". */
const modelOf = (title: string) =>
  title.startsWith(`${showcase.brand} `) ? title.slice(showcase.brand.length + 1) : title

/** Número curto em destaque; nome longo desce de tamanho para caber no card. */
const modelSize = (model: string) =>
  model.length <= 6
    ? 'text-[1.9rem] sm:text-[2.1rem]'
    : model.length <= 12
      ? 'text-[1.45rem]'
      : 'text-[1.15rem]'
---

<Section id="vitrine" tone={tone} rhythm={rhythm} data-showcase>
  <div class="max-w-4xl">
    <span class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.22em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-[3px] w-6 rounded-full bg-accent-orange"></span>
      {showcase.eyebrow}
    </span>
    <h2 class="mt-3 font-display text-3xl leading-[1.08] font-extrabold tracking-[-0.025em] text-ink sm:text-4xl lg:text-[2.9rem]">
      {titleLead} <span class="text-accent-orange">{showcase.titleHighlight}</span>
    </h2>
    <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px]">
      {showcase.text}
    </p>
  </div>

  <div class="mt-10 space-y-10 lg:space-y-6">
    {shelves.map((shelf) => (
      <div
        data-showcase-shelf
        class="lg:grid lg:grid-cols-3 lg:gap-5 xl:grid-cols-6"
        aria-labelledby={grouped ? `vitrine-${shelf.id}` : undefined}
        role={grouped ? 'group' : undefined}
      >
        {grouped && (
          <div
            class:list={[
              'showcase-tech relative mb-4 flex items-start gap-4 overflow-hidden rounded-[20px] p-4 ring-1 ring-brand-leaf/20 sm:p-5 lg:mb-0 lg:flex-col lg:gap-0 lg:p-6',
              headSpan[shelf.items.length] ?? 'lg:col-span-full',
            ]}
          >
            {shelf.icon && (
              <Icon
                name={shelf.icon}
                class="pointer-events-none absolute -right-6 -bottom-8 hidden size-40 text-accent-orange/[0.07] lg:block"
              />
            )}
            {shelf.icon && (
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary-dark text-brand-glow shadow-[0_12px_24px_-14px_rgba(6,67,55,0.9)]">
                <Icon name={shelf.icon} class="size-[21px]" />
              </span>
            )}
            <div class="relative min-w-0 flex-1 lg:mt-5 lg:flex lg:w-full lg:flex-col">
              <h3
                id={`vitrine-${shelf.id}`}
                class="font-display text-[1.15rem] leading-tight font-extrabold tracking-[-0.015em] text-ink lg:text-[1.3rem]"
              >
                {shelf.label}
              </h3>
              <p class="mt-1.5 font-sans text-[13.5px] leading-relaxed text-ink-soft lg:mt-2 lg:max-w-[22rem]">
                {shelf.description}
              </p>
              <span aria-hidden="true" class="hidden flex-1 lg:block lg:min-h-5" />
              <span class="mt-2.5 inline-flex items-center gap-2 font-sans text-[11.5px] font-bold tracking-[0.18em] text-accent-orange uppercase lg:mt-0">
                <span aria-hidden="true" class="h-[2px] w-5 rounded-full bg-accent-orange" />
                {countLabel(shelf.items.length)}
              </span>
            </div>
          </div>
        )}

        <ul
          data-showcase-rail
          aria-label={shelf.label}
          class="scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:contents"
        >
          {shelf.items.map((item) => {
            const model = modelOf(item.title)
            return (
              <li class="w-[62%] shrink-0 snap-start sm:w-[36%] lg:w-auto">
                <button
                  type="button"
                  data-cta={`vitrine-${item.id}`}
                  class="btn-slave-whats showcase-card group flex h-full w-full flex-col overflow-hidden rounded-[20px] bg-neutral-light text-left shadow-[0_1px_2px_rgba(6,67,55,0.06),0_18px_40px_-28px_rgba(6,67,55,0.45)] ring-1 ring-primary-dark/10 hover:ring-brand-leaf/40 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(6,67,55,0.6)]"
                >
                  <span class="showcase-card__stage relative flex aspect-[4/3] items-center justify-center overflow-hidden">
                    <span
                      aria-hidden="true"
                      class="showcase-card__floor absolute inset-x-[18%] bottom-[7%] h-[9%] rounded-[50%]"
                    />
                    <Image
                      src={item.photo.src}
                      alt={item.photo.alt}
                      format="webp"
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1280px) 210px, (min-width: 1024px) 300px, (min-width: 640px) 36vw, 62vw"
                      loading="lazy"
                      decoding="async"
                      class="showcase-card__img relative h-full w-full object-contain px-4 pt-5 pb-4 transition-transform duration-500 ease-out group-hover:-translate-y-1 group-hover:scale-[1.04]"
                    />
                  </span>

                  <span class="showcase-card__panel relative flex flex-1 flex-col px-4 pt-4 pb-4 sm:px-5">
                    <span class="font-sans text-[10.5px] font-bold tracking-[0.18em] text-neutral-light/85 uppercase">
                      {showcase.brand}
                    </span>
                    <span
                      class:list={[
                        'mt-0.5 font-display leading-[1.12] font-extrabold tracking-[-0.01em] text-neutral-light',
                        modelSize(model),
                      ]}
                    >
                      {model}
                    </span>
                    {showText && (
                      <span class="mt-1.5 font-sans text-[12.5px] leading-relaxed text-neutral-light/75">
                        {item.description}
                      </span>
                    )}
                    <span aria-hidden="true" class="min-h-3 flex-1" />
                    <span class="flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                      <span class="font-sans text-[13.5px] font-medium text-neutral-light/90">
                        {showcase.itemCta}
                      </span>
                      <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light transition-[transform,background-color,color] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-glow group-hover:text-primary-dark-900">
                        <Icon name="arrow-right" class="size-4" />
                      </span>
                    </span>
                  </span>
                </button>
              </li>
            )
          })}
        </ul>

        {shelf.items.length > 2 && (
          <div class="mt-2 flex items-center justify-center gap-3 sm:hidden">
            <button
              type="button"
              data-rail-prev
              aria-label={`Modelo anterior de ${shelf.label}`}
              class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
            >
              <Icon name="chevron-right" class="size-4 rotate-180" />
            </button>
            <button
              type="button"
              data-rail-next
              aria-label={`Próximo modelo de ${shelf.label}`}
              class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
            >
              <Icon name="chevron-right" class="size-4" />
            </button>
          </div>
        )}
      </div>
    ))}
  </div>

  <ContactStrip
    cta="vitrine-ajuda"
    title={showcase.help.text}
    note={showcase.help.note}
    label={showcase.help.cta}
    class="mt-12"
  />
</Section>

<style>
  /* Palco claro da foto: luz no centro, menta suave nas bordas e sombra de piso sob o produto. */
  .showcase-card__stage {
    background:
      radial-gradient(65% 60% at 50% 42%, #ffffff 0%, transparent 100%),
      linear-gradient(180deg, #eef5f2 0%, #f8fbfa 100%);
  }

  .showcase-card__floor {
    background: radial-gradient(closest-side, rgb(6 67 55 / 0.22), transparent);
    transition:
      transform 500ms ease-out,
      opacity 500ms ease-out;
  }

  .showcase-card:hover .showcase-card__floor {
    transform: scaleX(0.9);
    opacity: 0.7;
  }

  .showcase-card__img {
    filter: drop-shadow(0 14px 14px rgb(6 67 55 / 0.14));
  }

  /* Fio menta no topo do painel, separando foto e texto. */
  .showcase-card__panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-brand-glow), transparent);
    opacity: 0.55;
  }

  /* Painel verde-escuro do card, com um brilho sutil no topo. */
  .showcase-card__panel {
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.07) 0%, transparent 60%),
      linear-gradient(
        165deg,
        var(--color-primary-dark-800) 0%,
        var(--color-primary-dark) 55%,
        var(--color-primary-dark-900) 100%
      );
  }

  /* Bloco que abre cada faixa: menta claro com luz no canto. */
  .showcase-tech {
    background:
      radial-gradient(90% 70% at 0% 0%, rgb(124 239 192 / 0.28) 0%, transparent 65%),
      linear-gradient(160deg, var(--color-brand-mint-soft) 0%, #f6fbf9 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-card,
    .showcase-card * {
      transition: none !important;
    }

    .showcase-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Trilho do celular: setas que rolam um card por vez, em cada faixa.
  document.querySelectorAll<HTMLElement>('[data-showcase-shelf]').forEach((shelf) => {
    const rail = shelf.querySelector<HTMLElement>('[data-showcase-rail]')
    const prev = shelf.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = shelf.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!rail || !prev || !next) return

    const step = () => {
      const card = rail.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : rail.clientWidth * 0.8
    }
    const go = (dir: number) =>
      rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' })

    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
  })
</script>
