---
/**
 * Vitrine de produtos — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master, mockup de 26/10/2026 (docs/BRIEFING.md): os grupos viram
 * abas acessíveis, com a contagem de modelos; cada card tem a foto grande em cima e um
 * painel verde-escuro com a marca, o modelo em destaque e "Ver equipamento"; uma faixa de ajuda
 * fecha a seção. Refino de 05/11/2026: abas num controle segmentado com ícone e contagem, fim do
 * H2 em verde, palco da foto com luz e sombra de piso, e a ajuda num cartão com botão.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor,
 * reaplique a variante.
 *
 * Sem grupos, a vitrine continua uma grade só, sem abas.
 *
 * As duas invariantes do conteúdo são verificadas aqui, no build, porque o
 * `contract` do manifesto não expressa condição entre itens: descrição é tudo ou
 * nada, e todo item de vitrine agrupada aponta para um grupo existente.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { showcase, type ShowcaseGroup, type ShowcaseItem } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Tipos largos de propósito: o `as const` dos dados deixa `groups: []` como `readonly []`
// e os ids como literais, e as verificações abaixo virariam `never` na vitrine sem grupos.
const { groups, items }: { groups: readonly ShowcaseGroup[]; items: readonly ShowcaseItem[] } =
  showcase

const described = items.filter((item) => item.description.trim()).length
if (described !== 0 && described !== items.length) {
  throw new Error(
    `vitrine: descrição é tudo ou nada — ${described} de ${items.length} itens têm a frase. ` +
      'Complete os que faltam ou apague todas: meia lista descrita lê como página inacabada.',
  )
}
const showText = described === items.length

const groupIds = new Set(groups.map((group) => group.id))
for (const item of items) {
  // Com grupos, item sem grupo não cai em aba nenhuma e sumiria da página em silêncio.
  if ((groups.length || item.group) && !groupIds.has(item.group)) {
    throw new Error(
      item.group
        ? `vitrine: o item "${item.id}" aponta para o grupo "${item.group}", que não existe em groups.`
        : `vitrine: o item "${item.id}" está sem grupo — com groups preenchido, todo item aponta para um deles.`,
    )
  }
}

/** Com grupos, uma aba por grupo; sem grupos, um painel só, sem abas. */
const tabbed = groups.length > 0
const shelves = tabbed
  ? groups.map((group) => ({
      id: group.id,
      label: group.label,
      icon: group.icon,
      items: items.filter((item) => item.group === group.id),
    }))
  : [{ id: 'todos', label: showcase.title, icon: null, items: [...items] }]

for (const shelf of shelves) {
  if (!shelf.items.length) {
    throw new Error(
      `vitrine: o grupo "${shelf.id}" está sem itens. Remova o grupo ou aponte itens para ele.`,
    )
  }
}

const titleLead = showcase.title.endsWith(showcase.titleHighlight)
  ? showcase.title.slice(0, -showcase.titleHighlight.length).trim()
  : showcase.title
if (titleLead === showcase.title) {
  throw new Error('vitrine: titleHighlight precisa ser o final exato de title.')
}

const countLabel = (n: number) => `${n} ${n === 1 ? 'modelo' : 'modelos'}`

/** O card mostra a marca em cima e o modelo em destaque: "Markem-Imaje 9018" → "9018". */
const modelOf = (title: string) =>
  title.startsWith(`${showcase.brand} `) ? title.slice(showcase.brand.length + 1) : title

/** Número curto em destaque; nome longo desce de tamanho para caber no card. */
const modelSize = (model: string) =>
  model.length <= 6
    ? 'text-[1.9rem] sm:text-[2.1rem]'
    : model.length <= 12
      ? 'text-[1.45rem]'
      : 'text-[1.15rem]'
---

<Section id="vitrine" tone={tone} rhythm={rhythm} data-showcase>
  <div class="max-w-4xl">
    <span class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.22em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-[3px] w-6 rounded-full bg-accent-orange"></span>
      {showcase.eyebrow}
    </span>
    <h2 class="mt-3 font-display text-3xl leading-[1.08] font-extrabold tracking-[-0.025em] text-ink sm:text-4xl lg:text-[2.9rem]">
      {titleLead} <span class="text-accent-orange">{showcase.titleHighlight}</span>
    </h2>
    <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-[17px]">
      {showcase.text}
    </p>
  </div>

  {tabbed && (
    <div class="scroll-track -mx-6 mt-9 overflow-x-auto px-6 pb-1 sm:mx-0 sm:px-0">
      <div
        role="tablist"
        aria-label="Tecnologias"
        class="inline-flex gap-1 rounded-2xl bg-neutral-light p-1.5 shadow-[0_14px_34px_-24px_rgba(6,67,55,0.5)] ring-1 ring-primary-dark/10"
      >
        {shelves.map((shelf, i) => (
          <button
            type="button"
            role="tab"
            id={`vitrine-aba-${shelf.id}`}
            aria-controls={`vitrine-painel-${shelf.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-showcase-tab
            class="showcase-tab group/tab inline-flex shrink-0 items-center gap-2.5 rounded-xl px-4 py-2.5 font-sans text-[14.5px] font-semibold whitespace-nowrap text-ink-soft transition-[background-color,color,box-shadow] duration-200 hover:bg-brand-mint-soft hover:text-primary-dark aria-selected:bg-primary-dark aria-selected:text-neutral-light aria-selected:shadow-[0_10px_22px_-12px_rgba(6,67,55,0.9)] sm:px-5 sm:text-[15px]"
          >
            {shelf.icon && (
              <Icon
                name={shelf.icon}
                class="size-[18px] text-accent-orange transition-colors group-aria-selected/tab:text-brand-glow"
              />
            )}
            {shelf.label}
            <span
              aria-hidden="true"
              class="rounded-full bg-primary-dark/8 px-2 py-0.5 text-[11.5px] font-bold text-primary-dark/70 tabular-nums group-aria-selected/tab:bg-white/15 group-aria-selected/tab:text-neutral-light"
            >
              {shelf.items.length}
            </span>
            <span class="sr-only">({countLabel(shelf.items.length)})</span>
          </button>
        ))}
      </div>
    </div>
  )}

  {shelves.map((shelf, i) => (
    <div
      role={tabbed ? 'tabpanel' : undefined}
      id={`vitrine-painel-${shelf.id}`}
      aria-labelledby={tabbed ? `vitrine-aba-${shelf.id}` : undefined}
      hidden={i !== 0}
      data-showcase-panel
      class:list={['showcase-panel', tabbed ? 'mt-7' : 'mt-9']}
    >
      <ul
        data-showcase-rail
        aria-label={shelf.label}
        class="scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:scroll-px-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      >
        {shelf.items.map((item) => {
          const model = modelOf(item.title)
          return (
            <li class="w-[66%] shrink-0 snap-start sm:w-[40%] lg:w-auto">
              <button
                type="button"
                data-cta={`vitrine-${item.id}`}
                class="btn-slave-whats showcase-card group flex h-full w-full flex-col overflow-hidden rounded-[20px] bg-neutral-light text-left shadow-[0_1px_2px_rgba(6,67,55,0.06),0_18px_40px_-28px_rgba(6,67,55,0.45)] ring-1 ring-primary-dark/10 hover:ring-brand-leaf/40 transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_60px_-30px_rgba(6,67,55,0.6)]"
              >
                <span class="showcase-card__stage relative flex aspect-[4/3] items-center justify-center overflow-hidden">
                  <span
                    aria-hidden="true"
                    class="showcase-card__floor absolute inset-x-[18%] bottom-[7%] h-[9%] rounded-[50%]"
                  />
                  <Image
                    src={item.photo.src}
                    alt={item.photo.alt}
                    format="webp"
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 240px, (min-width: 640px) 40vw, 66vw"
                    loading="lazy"
                    decoding="async"
                    class="showcase-card__img relative h-full w-full object-contain px-4 pt-5 pb-4 transition-transform duration-500 ease-out group-hover:-translate-y-1 group-hover:scale-[1.04]"
                  />
                </span>

                <span class="showcase-card__panel relative flex flex-1 flex-col px-4 pt-4 pb-4 sm:px-5">
                  <span class="font-sans text-[10.5px] font-bold tracking-[0.18em] text-neutral-light/85 uppercase">
                    {showcase.brand}
                  </span>
                  <span
                    class:list={[
                      'mt-0.5 font-display leading-[1.12] font-extrabold tracking-[-0.01em] text-neutral-light',
                      modelSize(model),
                    ]}
                  >
                    {model}
                  </span>
                  {showText && (
                    <span class="mt-1.5 font-sans text-[12.5px] leading-relaxed text-neutral-light/75">
                      {item.description}
                    </span>
                  )}
                  <span aria-hidden="true" class="min-h-3 flex-1" />
                  <span class="flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                    <span class="font-sans text-[13.5px] text-neutral-light/90">
                      {showcase.itemCta}
                    </span>
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-leaf text-neutral-light transition-[transform,background-color,color] duration-300 group-hover:translate-x-0.5 group-hover:bg-brand-glow group-hover:text-primary-dark-900">
                      <Icon name="arrow-right" class="size-4" />
                    </span>
                  </span>
                </span>
              </button>
            </li>
          )
        })}
      </ul>

      {shelf.items.length > 1 && (
        <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
          <button
            type="button"
            data-rail-prev
            aria-label={`Modelo anterior de ${shelf.label}`}
            class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
          >
            <Icon name="chevron-right" class="size-4 rotate-180" />
          </button>
          <button
            type="button"
            data-rail-next
            aria-label={`Próximo modelo de ${shelf.label}`}
            class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
          >
            <Icon name="chevron-right" class="size-4" />
          </button>
        </div>
      )}
    </div>
  ))}

  <div class="showcase-help relative mt-12 flex flex-col gap-5 overflow-hidden rounded-[20px] p-6 ring-1 ring-brand-leaf/20 sm:flex-row sm:items-center sm:gap-6 sm:p-7 lg:px-9">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-primary-dark text-brand-glow shadow-[0_12px_24px_-14px_rgba(6,67,55,0.9)]">
      <Icon name="chat" class="size-[22px]" />
    </span>
    <div class="flex-1">
      <p class="font-display text-lg leading-snug font-bold text-ink sm:text-xl">
        {showcase.help.text}
      </p>
      <p class="mt-1 font-sans text-[14.5px] leading-relaxed text-ink-soft">{showcase.help.note}</p>
    </div>
    <Button
      cta="vitrine-ajuda"
      variant="primary"
      class="w-full shrink-0 whitespace-nowrap sm:w-auto"
    >
      {showcase.help.cta}
    </Button>
  </div>
</Section>

<style>
  /* Palco claro da foto: luz no centro, menta suave nas bordas e sombra de piso sob o produto. */
  .showcase-card__stage {
    background:
      radial-gradient(65% 60% at 50% 42%, #ffffff 0%, transparent 100%),
      linear-gradient(180deg, #eef5f2 0%, #f8fbfa 100%);
  }

  .showcase-card__floor {
    background: radial-gradient(closest-side, rgb(6 67 55 / 0.22), transparent);
    transition:
      transform 500ms ease-out,
      opacity 500ms ease-out;
  }

  .showcase-card:hover .showcase-card__floor {
    transform: scaleX(0.9);
    opacity: 0.7;
  }

  .showcase-card__img {
    filter: drop-shadow(0 14px 14px rgb(6 67 55 / 0.14));
  }

  /* Fio menta no topo do painel, separando foto e texto. */
  .showcase-card__panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-brand-glow), transparent);
    opacity: 0.55;
  }

  /* Cartão de ajuda: menta claro com luz no canto. */
  .showcase-help {
    background:
      radial-gradient(60% 140% at 100% 0%, rgb(124 239 192 / 0.35) 0%, transparent 60%),
      linear-gradient(120deg, var(--color-brand-mint-soft) 0%, #f4fbf8 100%);
  }

  /* Painel verde-escuro do card, com um brilho sutil no topo. */
  .showcase-card__panel {
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.07) 0%, transparent 60%),
      linear-gradient(
        165deg,
        var(--color-primary-dark-800) 0%,
        var(--color-primary-dark) 55%,
        var(--color-primary-dark-900) 100%
      );
  }

  /* Troca de aba: o painel novo entra subindo 6px. */
  .showcase-panel:not([hidden]) {
    animation: showcase-in 320ms ease-out;
  }

  @keyframes showcase-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-panel:not([hidden]) {
      animation: none;
    }

    .showcase-card,
    .showcase-card * {
      transition: none !important;
    }

    .showcase-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-showcase-tab]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-showcase-panel]')]

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
      })
      panels.forEach((panel, i) => {
        panel.hidden = i !== index
      })
      if (focus) tabs[index].focus()
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i))
      // Setas, Home e End movem entre as abas (roving tabindex).
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1
        const to =
          event.key === 'ArrowRight'
            ? i === last
              ? 0
              : i + 1
            : event.key === 'ArrowLeft'
              ? i === 0
                ? last
                : i - 1
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : -1
        if (to < 0) return
        event.preventDefault()
        select(to, true)
      })
    })

    // Trilho do mobile: setas que rolam um card por vez.
    panels.forEach((panel) => {
      const rail = panel.querySelector<HTMLElement>('[data-showcase-rail]')
      const prev = panel.querySelector<HTMLButtonElement>('[data-rail-prev]')
      const next = panel.querySelector<HTMLButtonElement>('[data-rail-next]')
      if (!rail || !prev || !next) return

      const step = () => {
        const card = rail.querySelector<HTMLElement>('li')
        return card ? card.offsetWidth + 16 : rail.clientWidth * 0.8
      }
      const go = (dir: number) =>
        rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' })

      prev.addEventListener('click', () => go(-1))
      next.addEventListener('click', () => go(1))
    })
  })
</script>
