---
/**
 * Vitrine de produtos — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL — Print Master (docs/BRIEFING.md). Pedido de 05/11/2026: mesma estética da LP
 * de locação — H2 à esquerda com o cartão de ajuda à direita, cards brancos com palco menta, selo
 * da tecnologia, marca, modelo e botão de cotação. Sem abas nem filtro — três blocos
 * compactos apresentam as tecnologias (ícone, nome e frase, sem contagem) e os 12 modelos ficam numa
 * grade só (4 × 3 no desktop, sem sobras); fim do H2 em verde.
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: ao recompor,
 * reaplique a variante.
 *
 * Sem grupos, a vitrine continua uma grade só.
 *
 * As duas invariantes do conteúdo são verificadas aqui, no build, porque o
 * `contract` do manifesto não expressa condição entre itens: descrição é tudo ou
 * nada, e todo item de vitrine agrupada aponta para um grupo existente.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import { cta } from '@data/content'
import type { SectionProps } from '@lib/layout'
import { showcase, type ShowcaseGroup, type ShowcaseItem } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Tipos largos de propósito: o `as const` dos dados deixa `groups: []` como `readonly []`
// e os ids como literais, e as verificações abaixo virariam `never` na vitrine sem grupos.
const { groups, items }: { groups: readonly ShowcaseGroup[]; items: readonly ShowcaseItem[] } =
  showcase

const described = items.filter((item) => item.description.trim()).length
if (described !== 0 && described !== items.length) {
  throw new Error(
    `vitrine: descrição é tudo ou nada — ${described} de ${items.length} itens têm a frase. ` +
      'Complete os que faltam ou apague todas: meia lista descrita lê como página inacabada.',
  )
}
const showText = described === items.length

const groupIds = new Set(groups.map((group) => group.id))
for (const item of items) {
  // Com grupos, item sem grupo não cai em faixa nenhuma e sumiria da página em silêncio.
  if ((groups.length || item.group) && !groupIds.has(item.group)) {
    throw new Error(
      item.group
        ? `vitrine: o item "${item.id}" aponta para o grupo "${item.group}", que não existe em groups.`
        : `vitrine: o item "${item.id}" está sem grupo — com groups preenchido, todo item aponta para um deles.`,
    )
  }
}

/** Com grupos, uma faixa por tecnologia, todas à vista; sem grupos, uma grade só. */
const grouped = groups.length > 0
const shelves = grouped
  ? groups.map((group) => ({
      id: group.id,
      label: group.label,
      icon: group.icon,
      description: group.description,
      items: items.filter((item) => item.group === group.id),
    }))
  : [{ id: 'todos', label: showcase.title, icon: null, description: '', items: [...items] }]

/** Grupo de cada item, para o selo do card. A grade segue a ordem dos grupos. */
const groupOf = new Map(groups.map((group) => [group.id, group]))
const ordered = grouped ? shelves.flatMap((shelf) => shelf.items) : [...items]

for (const shelf of shelves) {
  if (!shelf.items.length) {
    throw new Error(
      `vitrine: o grupo "${shelf.id}" está sem itens. Remova o grupo ou aponte itens para ele.`,
    )
  }
}

const titleLead = showcase.title.endsWith(showcase.titleHighlight)
  ? showcase.title.slice(0, -showcase.titleHighlight.length).trim()
  : showcase.title
if (titleLead === showcase.title) {
  throw new Error('vitrine: titleHighlight precisa ser o final exato de title.')
}

/** O card mostra a marca em cima e o modelo em destaque: "Markem-Imaje 9018" → "9018". */
const modelOf = (title: string) =>
  title.startsWith(`${showcase.brand} `) ? title.slice(showcase.brand.length + 1) : title

/** Mesmo tamanho para todo modelo, como os títulos dos cards da LP de locação. */
const modelSize = () => 'text-[1.05rem] sm:text-[1.35rem]'
---

<Section id="vitrine" tone={tone} rhythm={rhythm} class="showcase" data-showcase>
  {/* Cabeçalho como o dos produtos da LP de locação: H2 à esquerda, ajuda à direita */}
  <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
    <div class="min-w-0">
      <h2 class="font-display text-[2.2rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance text-ink sm:text-5xl lg:text-[3.35rem] lg:whitespace-nowrap">
        {titleLead} <span class="text-accent-orange">{showcase.titleHighlight}</span>
      </h2>
      <p class="mt-5 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-lg lg:whitespace-nowrap">
        {showcase.text}
      </p>
    </div>

    <div class="flex shrink-0 flex-col gap-4 rounded-2xl border border-primary-dark/15 bg-neutral-light/60 p-5 shadow-[0_20px_40px_-28px_rgba(6,67,55,0.5)] backdrop-blur-md lg:w-[380px]">
      <div class="flex items-center gap-3">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-accent-orange ring-1 ring-brand-mint/60">
          <Icon name="chat" class="size-[18px]" />
        </span>
        <p class="font-sans text-[15px] leading-snug font-bold text-primary-dark">
          {showcase.help.text}
        </p>
      </div>
      <Button cta="vitrine-ajuda" class="w-full sm:whitespace-nowrap">
        {showcase.help.cta}
      </Button>
    </div>
  </div>

  {grouped && (
    <ul class="mt-10 grid gap-3 sm:grid-cols-3 sm:gap-5" aria-label="Tecnologias">
      {shelves.map((shelf) => (
        <li class="flex items-start gap-4 rounded-2xl border border-primary-dark/10 bg-neutral-light/70 p-4 backdrop-blur-sm sm:p-5">
          {shelf.icon && (
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-mint-soft text-accent-orange ring-1 ring-brand-mint/60">
              <Icon name={shelf.icon} class="size-[19px]" />
            </span>
          )}
          <div class="min-w-0">
            <h3 class="font-display text-[1.1rem] leading-tight font-extrabold text-ink">
              {shelf.label}
            </h3>
            <p class="mt-1.5 font-sans text-[14px] leading-relaxed text-ink-soft">
              {shelf.description}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )}

  {/* Cards no desenho da LP de locação: palco menta com selo, título e botão */}
  <ul
    aria-label={showcase.title}
    class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 xl:grid-cols-4"
  >
    {ordered.map((item) => {
      const model = modelOf(item.title)
      const tech = groupOf.get(item.group)
      return (
        <li>
          <button
            type="button"
            data-cta={`vitrine-${item.id}`}
            class="btn-slave-whats showcase-card group flex h-full w-full flex-col rounded-[22px] border border-primary-dark/10 bg-neutral-light p-2 text-left shadow-[0_22px_44px_-30px_rgba(6,67,55,0.45)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_30px_56px_-30px_rgba(6,67,55,0.55)] sm:p-3"
          >
            <span class="showcase-stage relative flex aspect-[6/5] w-full items-center justify-center overflow-hidden rounded-2xl">
              {tech && (
                <span class="absolute top-2.5 left-2.5 z-[2] rounded-full bg-brand-mint-soft px-2.5 py-1 font-sans text-[9.5px] font-bold tracking-[0.08em] text-primary-dark uppercase ring-1 ring-brand-mint/50 sm:top-3 sm:left-3 sm:px-3 sm:py-1.5 sm:text-[10.5px]">
                  {tech.short}
                </span>
              )}
              <Image
                src={item.photo.src}
                alt={item.photo.alt}
                format="webp"
                widths={[320, 480, 640]}
                sizes="(min-width: 1280px) 300px, (min-width: 1024px) 30vw, 46vw"
                loading="lazy"
                decoding="async"
                class="relative z-[1] mt-5 max-h-[84%] w-auto max-w-[88%] object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
              />
            </span>

            <span class="flex flex-1 flex-col px-1.5 pt-4 pb-1.5 sm:px-3 sm:pt-5 sm:pb-3">
              <span class="font-sans text-[10.5px] font-bold tracking-[0.16em] text-accent-orange uppercase">
                {showcase.brand}
              </span>
              <span
                class:list={['mt-1 font-display leading-snug font-extrabold text-ink', modelSize()]}
              >
                {model}
              </span>
              {showText && (
                <span class="mt-2 font-sans text-[14px] leading-relaxed text-ink-soft">
                  {item.description}
                </span>
              )}
              <span aria-hidden="true" class="min-h-4 flex-1 sm:min-h-5" />
              {/* Aparência do Button primary: o card inteiro já é o botão */}
              <span class="inline-flex w-full items-center justify-between gap-2 rounded-full bg-accent-orange px-4 py-2.5 font-sans text-[13px] font-bold text-neutral-light shadow-[0_18px_36px_-16px_rgba(2,118,83,0.8)] transition-colors duration-200 group-hover:bg-accent-orange-dark sm:px-6 sm:py-3.5 sm:text-[15px]">
                <span class="sm:hidden">{cta.primaryShort}</span>
                <span class="hidden sm:inline">{cta.primary}</span>
                <Icon
                  name="arrow-right"
                  class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </span>
            </span>
          </button>
        </li>
      )
    })}
  </ul>
</Section>

<style>
  /* Camada menta sobre o tom da seção, nascendo e dissolvendo em branco (sem divisa com Soluções) */
  :global([data-showcase]) {
    background-image:
      radial-gradient(900px 420px at 85% 160px, rgb(97 229 169 / 0.12) 0%, transparent 70%),
      linear-gradient(180deg, #ffffff 0, #f0f9f5 220px, #f5fbf8 70%, #ffffff 100%);
  }

  /* Palco menta da foto, com brilho sob o produto */
  .showcase-stage {
    background-image:
      radial-gradient(ellipse 70% 55% at 50% 70%, rgb(97 229 169 / 0.24) 0%, transparent 72%),
      linear-gradient(180deg, #e9f6f0 0%, #f3faf7 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-card,
    .showcase-card * {
      transition: none !important;
    }

    .showcase-card:hover {
      transform: none;
    }
  }
</style>
