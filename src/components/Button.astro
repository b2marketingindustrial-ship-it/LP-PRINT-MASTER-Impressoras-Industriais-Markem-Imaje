---
/**
 * Botão de CTA do padrão B2.
 * - Sempre <button type="button"> com `btn-slave-whats`: o plugin de atendimento do WordPress captura o clique.
 * - `cta` é obrigatório e vira `data-cta` para rastreamento (convenção: `{secao}-{elemento}`).
 * - Pílula (rounded-full), ícone arrow-right à direita por padrão. Tamanhos: `md` (padrão), `sm` (header) e `lg` (hero e bloco de diferenciais).
 * - Todo CTA do site usa este componente: não estilize <button> de CTA à mão.
 */
import Icon from './Icon.astro'
import type { IconName } from '../data/icons'

interface Props {
  /** Identificador de rastreamento, ex.: "hero-primary", "linhas-esferas". */
  cta: string
  variant?: 'primary' | 'mint' | 'emerald' | 'outline-light' | 'outline-dark'
  type?: 'button' | 'submit'
  size?: 'sm' | 'md' | 'lg'
  icon?: boolean
  iconName?: IconName
  iconPosition?: 'left' | 'right'
  class?: string
}

const {
  cta,
  variant = 'primary',
  type = 'button',
  size = 'md',
  icon = true,
  iconName = 'arrow-right',
  iconPosition = 'right',
  class: className = '',
} = Astro.props

const base =
  'group inline-flex items-center justify-center gap-2.5 rounded-full font-sans font-bold transition-colors duration-200'

const sizes = {
  lg: 'px-8 py-4 text-[17px] xl:px-10 xl:py-[1.15rem] xl:text-[19px]',
  md: 'px-7 py-3.5 text-[15px]',
  sm: 'px-4 py-2.5 text-[12px] sm:px-6 sm:py-3 sm:text-[14px]',
}

const variants = {
  primary:
    'bg-accent-orange text-neutral-light shadow-[0_18px_36px_-16px_rgba(2,118,83,0.8)] hover:bg-accent-orange-dark',
  /* Verde vivo do mockup de abertura, sobre fundo verde-escuro. */
  emerald:
    'bg-brand-emerald text-neutral-light shadow-[0_18px_44px_-16px_rgba(26,165,122,0.85)] ring-1 ring-brand-glow/30 ring-inset hover:bg-accent-orange',
  mint: 'bg-brand-mint text-primary-dark-900 shadow-[0_18px_36px_-16px_rgba(0,0,0,0.5)] hover:bg-neutral-light',
  'outline-light': 'border border-neutral-light/35 text-neutral-light hover:bg-neutral-light/10',
  'outline-dark':
    'border-2 border-primary-dark text-primary-dark hover:bg-primary-dark hover:text-neutral-light',
}
---

<button
  type={type}
  data-cta={cta}
  class:list={['btn-slave-whats', base, sizes[size], variants[variant], className]}
>
  {icon && iconPosition === 'left' && <Icon name={iconName} class="size-4 shrink-0" />}
  <span>
    <slot />
  </span>
  {icon && iconPosition === 'right' && (
    <Icon
      name={iconName}
      class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
    />
  )}
</button>
