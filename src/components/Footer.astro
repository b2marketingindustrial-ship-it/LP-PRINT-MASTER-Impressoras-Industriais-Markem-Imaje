---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.5). Uma linha: copyright · endereço · crédito da B2.
 * Sem menu, redes, telefone, e-mail, logo ou formulário.
 */
import Icon from './Icon.astro'
import { site } from '../data/site'
import { footer } from '../data/content'

const year = new Date().getFullYear()

// Quando o endereço quebra de linha (1024–1279px), o CEP não se separa do número.
const cepAt = site.address.lastIndexOf('CEP ')
const street = cepAt > 0 ? site.address.slice(0, cepAt) : site.address
const cep = cepAt > 0 ? site.address.slice(cepAt) : ''
---

<footer class="navy-premium border-t border-white/15">
  <div class="mx-auto flex max-w-page flex-col items-center gap-3 px-6 py-6 text-center lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-10 lg:text-left">
    <p class="shrink-0 font-sans text-xs text-neutral-light/55">
      © {year} {site.brand}. Todos os direitos reservados.
    </p>

    {/* Endereço numa linha só a partir de 1280px; em 1024px ele empurrava o crédito para fora (06/11/2026) */}
    <address class="flex items-center gap-2 font-sans text-xs text-neutral-light/70 not-italic xl:whitespace-nowrap">
      <Icon name="map-pin" class="size-3.5 shrink-0 text-accent-orange" />
      <span>
        {street}
        {cep && <span class="whitespace-nowrap">{cep}</span>}
      </span>
    </address>

    <p class="shrink-0 font-sans text-xs text-neutral-light/55">
      Desenvolvido por{' '}
      <a
        href={footer.credit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-neutral-light/80 transition-colors hover:text-accent-orange"
      >
        {footer.credit.label}
      </a>
    </p>
  </div>
</footer>
