---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), com o desvio visual do mockup de abertura da
 * Print Master (26/10/2026 — docs/BRIEFING.md): fundo verde-escuro, H1 em três linhas com a
 * marca em menta, pontos sem caixa, um botão em pílula e um link para a vitrine, o 9410 e o
 * 9750 lado a lado sob o selo da Markem-Imaje. Pedido do usuário (27/10/2026): o chat vem do
 * plugin — a coluna do shortcode é só um espaço vazio com altura reservada, sem prévia desenhada.
 * Fora do WordPress o texto cru do shortcode é apagado.
 *
 * Mockup do celular (27/10/2026): eyebrow, H1 e texto; selo e banner sangrando até as bordas;
 * depois os pontos, o botão e o link. Por isso a coluna de texto é dividida em dois blocos
 * (`hero-copy` e `hero-actions`), que no desktop voltam a ser a coluna 1, em duas linhas.
 *
 * Grid desktop: texto (--text-col) · janela dos equipamentos (1fr) · shortcode do chat (300px).
 * O par de equipamentos está no centro do banner (50% da largura), e esse centro é ancorado no
 * centro da coluna 2, em qualquer largura de tela. No mobile o banner vira um quadro sob o texto.
 * Abra a página com `?grid=1` para ver as colunas.
 */
import { Image, Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV

// O H1 continua sendo `hero.title` (é ele que o check:lp confere); o destaque só quebra linha.
const at = hero.title.indexOf(hero.highlight)
const titleBefore = at >= 0 ? hero.title.slice(0, at) : hero.title
const titleAfter = at >= 0 ? hero.title.slice(at + hero.highlight.length) : ''
---

<section class="hero relative isolate overflow-hidden bg-hero-deep" data-hero>
  {/* conteúdo — sem `relative` no contêiner: no desktop o banner se posiciona pelo hero */}
  <div class="mx-auto max-w-page px-6 pt-12 pb-14 lg:px-10 lg:py-14">
    <div class="hero-grid grid items-center gap-y-8 lg:gap-x-8 lg:gap-y-0">
      {/* Coluna 1 (linha 1) — eyebrow, H1 e texto */}
      <div class="hero-copy relative z-[3] max-w-xl lg:col-start-1 lg:row-start-1 lg:max-w-none">
        <span class="inline-flex items-center gap-3 font-sans text-[12px] font-medium tracking-[0.2em] text-brand-glow uppercase sm:text-[12.5px]">
          <span aria-hidden="true" class="h-[3px] w-9 rounded-full bg-brand-glow"></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-4 font-display text-[2.75rem] leading-[1] font-extrabold tracking-[-0.04em] text-neutral-light sm:text-[2.9rem] lg:text-[2.45rem] xl:text-[3.25rem]">
          {/* Duas linhas a partir do tablet: a 1ª não quebra; no celular o título quebra sozinho. */}
          <span class="sm:block sm:whitespace-nowrap">{titleBefore}</span>
          {at >= 0 && <span class="block text-brand-glow">{hero.highlight}</span>}
          {titleAfter}
        </h1>

        <p class="mt-5 max-w-[31rem] font-sans text-[17px] leading-relaxed text-neutral-light/80 lg:text-lg xl:text-[19px]">
          {hero.text}
        </p>
      </div>

      {/* Coluna 2 — janela dos equipamentos (no mobile, selo e banner sangrando até as bordas) */}
      <div class="hero-window lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <div class="hero-badge">
          <Image
            src={hero.badge.src}
            alt={hero.badge.alt}
            width={220}
            height={50}
            format="webp"
            loading="eager"
            decoding="async"
            class="h-8 w-auto sm:h-10 xl:h-11"
          />
        </div>
        <div class="hero-photo">
          <Picture
            src={hero.banner.src}
            alt={hero.banner.alt}
            widths={[640, 1024, 1536, 1752]}
            sizes="(min-width: 1024px) 1720px, 220vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero-photo-img"
            pictureAttributes={{ class: 'block h-full' }}
          />
        </div>
      </div>

      {/* Coluna 1 (linha 2) — pontos, botão e link; no mobile vêm depois do banner */}
      <div class="hero-actions relative z-[3] max-w-xl lg:col-start-1 lg:row-start-2 lg:max-w-none">
        {/* 3 pontos numa barra de vidro (referência SEIVE, 05/11/2026): ícone em caixa, fios entre eles */}
        <ul
          class="hero-glass grid grid-cols-3 gap-x-3 rounded-2xl px-3 py-3.5 sm:flex sm:w-max sm:flex-nowrap sm:px-4 lg:mt-7 lg:grid lg:w-auto xl:flex xl:w-max xl:px-5 xl:py-4"
          aria-label="Destaques"
        >
          {hero.points.map((point) => (
            <li class="hero-point flex flex-1 flex-col items-start gap-2.5 sm:flex-row sm:items-center sm:gap-3 lg:flex-col lg:items-start lg:gap-2.5 xl:flex-row xl:items-center xl:gap-3">
              <span class="hero-glass__icon flex size-10 shrink-0 items-center justify-center rounded-xl text-brand-glow">
                <Icon name={point.icon} class="size-[22px]" />
              </span>
              <span class="font-sans text-[13px] leading-snug font-semibold text-neutral-light xl:text-[13.5px]">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>

        <Button cta="hero-primary" variant="emerald" size="lg" whatsapp class="mt-8">
          {cta.primary}
        </Button>

        <a
          href="#vitrine"
          data-cta="hero-secondary"
          class="group mt-6 flex w-fit items-center gap-3 border-b border-neutral-light/45 pb-1.5 font-sans text-base text-neutral-light/90 xl:text-[17px] transition-colors duration-200 hover:border-brand-glow hover:text-brand-glow"
        >
          {hero.link}
          <Icon
            name="arrow-right"
            class="size-5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      {/* Coluna 3 — espaço vazio para o chat do plugin (shortcode, 300px) */}
      <div
        class="hero-chat relative z-[3] min-h-[430px] w-full lg:col-start-3 lg:row-span-2 lg:row-start-1 lg:w-[300px]"
        data-shortcode-slot
      >
        <slot name="shortcode">
          {isDev && (
            <div
              class="flex min-h-[430px] w-full items-center justify-center rounded-2xl border border-dashed border-neutral-light/30 px-4 text-center font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-glow uppercase"
              aria-label="Espaço do chat (só em desenvolvimento)"
            >
              Espaço · chat do plugin
            </div>
          )}
        </slot>
      </div>
      {/*
        Fora do WordPress o shortcode chega como texto cru ("[atendimento_chat …]"). Este script
        roda durante o parse, antes da primeira pintura, e apaga o texto: o espaço fica vazio,
        com a altura reservada. No WordPress o plugin já trocou o shortcode e nada muda.
      */}
      <script is:inline>
        ;(() => {
          const slot = document.currentScript?.previousElementSibling
          if (!slot || /wordpress|printmaster\.net\.br/i.test(location.hostname)) return
          if (slot.children.length === 0 && /^\[[^\]]+\]$/.test(slot.textContent.trim()))
            slot.replaceChildren()
        })()
      </script>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-8">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x-2 border-dashed border-brand-glow bg-brand-glow/5 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-glow">
            col 2 · janela dos equipamentos
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Medidas que amarram as colunas e o banner ao mesmo eixo. */
  .hero {
    --text-col: 400px;
    /* Largura de referência do banner: fixa quando a coluna de texto alarga (H1 em 2 linhas). */
    /* Assim os equipamentos não encolhem — só andam para a direita (05/11/2026). */
    --photo-base: 400px;
    --chat-col: 300px;
    --col-gap: 2rem;
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Largura útil do contêiner (sem o px-10) e centro da coluna 2, a partir da borda da tela. */
    --inner: calc(min(100%, var(--container-page)) - 80px);
    --window-center: calc(
      var(--page-edge) + 40px + var(--text-col) + var(--col-gap) +
        (var(--inner) - var(--text-col) - var(--chat-col) - 2 * var(--col-gap)) / 2
    );
    /* Largura do banner: o par (36,8% da imagem) ocupa o espaço entre o texto e o chat. */
    /* Em vw (não %) para a mesma conta servir também ao `top` do selo. */
    --photo-w: calc(
      (min(100vw, var(--container-page)) - 80px - var(--photo-base) - var(--chat-col)) / 0.35
    );
  }

  /* Divisórias sutis entre os destaques. */
  .hero-point + .hero-point {
    padding-left: 0.75rem;
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }

  @media (min-width: 640px) {
    .hero-point + .hero-point {
      padding-left: 1rem;
    }
  }

  /* Barra de vidro: véu claro com desfoque, fio de luz no alto e sombra funda. */
  .hero-glass {
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1) 0%, rgb(255 255 255 / 0.03) 100%);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 24px 44px -26px rgb(0 0 0 / 0.75);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .hero-glass__icon {
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.16);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1);
  }

  /* Mobile (mockup de 27/10/2026): selo à esquerda, alinhado ao texto, e banner sangrando até
     as bordas da tela, com o par de equipamentos ocupando quase toda a largura. */
  .hero-window {
    position: relative;
    margin-inline: -1.5rem;
  }

  .hero-badge {
    position: relative;
    z-index: 3;
    width: fit-content;
    margin: 0 0 -3rem 1.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 0.75rem;
    background: var(--color-neutral-light);
    box-shadow: 0 20px 40px -22px rgb(0 0 0 / 0.75);
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
    /* Altura que mostra o par inteiro (ele vai de 31% a 95% da altura da imagem). */
    aspect-ratio: 1 / 0.95;
    /* Esmaece as laterais e o topo; embaixo o piso vai até a borda. */
    mask-image:
      linear-gradient(to right, transparent 0, black 10%, black 90%, transparent 100%),
      linear-gradient(to bottom, transparent 0, black 14%);
    mask-composite: intersect;
  }

  /* O par (36,8% da imagem) fica com ~80% da largura da tela, centrado pelo seu centro (52,5%). */
  .hero-photo :global(.hero-photo-img) {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: block;
    width: 220%;
    max-width: none;
    height: auto;
    transform: translateX(-52.5%);
  }

  /* Tablet: o banner não sangra e fica com largura limitada, selo centrado como antes. */
  @media (min-width: 640px) {
    .hero-window {
      margin-inline: 0;
    }

    .hero-badge {
      margin: 0 auto -3rem;
    }

    .hero-photo {
      max-width: 640px;
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) {
    /* Col 1 texto | Col 2 janela dos equipamentos | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, var(--text-col)) minmax(0, 1fr) var(--chat-col);
    }

    .hero {
      min-height: 680px;
    }

    .hero-window {
      position: static;
      align-self: stretch;
      margin: 0;
    }

    /* Banner pela base, na largura --photo-w; o par, a 52,5% da imagem, cai no centro da col. 2. */
    .hero-photo {
      position: absolute;
      top: auto;
      bottom: 0;
      width: var(--photo-w);
      left: calc(var(--window-center));
      z-index: 1;
      max-width: none;
      margin: 0;
      aspect-ratio: auto;
      transform: translateX(-52.5%);
      /* O img volta a ser estático: quem se posiciona no desktop é o quadro .hero-photo. */
      /* Esmaece as laterais e o topo: com o banner encolhido, a borda de cima não vira linha. */
      mask-image:
        linear-gradient(to right, transparent 0, black 10%, black 90%, transparent 100%),
        linear-gradient(to bottom, transparent 0, black 18%);
      mask-composite: intersect;
    }

    .hero-photo :global(.hero-photo-img) {
      position: static;
      width: 100%;
      max-width: none;
      height: auto;
      transform: none;
    }

    /* Selo a 19% da altura da imagem (1752×898), acima dos equipamentos, como no mockup. */
    /* Altura da imagem = --photo-w / 1,951; 81,1% dela fica abaixo do selo. */
    .hero-badge {
      position: absolute;
      top: calc(100% - var(--photo-w) * 0.4157);
      left: var(--window-center);
      margin: 0;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      /* H1 em duas linhas (pedido de 05/11/2026): "Codificadoras industriais" inteira na 1ª. */
      --text-col: 480px;
    }
  }

  @media (min-width: 1280px) {
    .hero {
      --text-col: 600px;
      --photo-base: 440px;
      min-height: 700px;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
